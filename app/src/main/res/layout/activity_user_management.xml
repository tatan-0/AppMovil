<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GESTIÓN DE USUARIOS"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="32dp" />

    <!-- Opción 1: Formulario de Registro -->
    <Button
        android:id="@+id/btnGoToRegister"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="INGRESAR USUARIOS"
        android:textStyle="bold"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp" />

    <!-- Opción 2: Lista y Búsqueda de Usuarios -->
    <Button
        android:id="@+id/btnGoToList"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="LISTAR USUARIOS"
        android:textStyle="bold"
        android:backgroundTint="#009688"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp" />

    <!-- Volver al Menú Principal -->
    <Button
        android:id="@+id/btnBackMenu"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="VOLVER AL MENÚ PRINCIPAL"
        android:backgroundTint="#757575"
        android:textColor="#FFFFFF" />

</LinearLayout>