<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MODIFICAR DATOS USUARIO"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etEditNombres"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="INGRESE NOMBRES"
        android:paddingHorizontal="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etEditApellidos"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="INGRESE APELLIDOS"
        android:paddingHorizontal="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etEditEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="INGRESE E-MAIL"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogModificar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="MODIFICAR"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDialogEliminar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="ELIMINAR"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>